<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Choice changes for a silent desktop-mode install:
     sudo installer -pkg Palisade.pkg -target / -applyChoiceChangesXML desktop-mode.plist -->
<plist version="1.0">
<array>
    <dict>
        <key>attributeSetting</key><integer>1</integer>
        <key>choiceAttribute</key><string>selected</string>
        <key>choiceIdentifier</key><string>desktop</string>
    </dict>
    <dict>
        <key>attributeSetting</key><integer>0</integer>
        <key>choiceAttribute</key><string>selected</string>
        <key>choiceIdentifier</key><string>service</string>
    </dict>
</array>
</plist>
