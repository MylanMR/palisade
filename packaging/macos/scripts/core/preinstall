#!/bin/bash
# Before files are replaced on an upgrade: stop Palisade so nothing runs half-old code.
# The mode package that follows starts it again.
launchctl bootout system/com.palisade.server 2>/dev/null || true
launchctl bootout system/com.palisade.setup 2>/dev/null || true
for uid in $(ps -axo uid=,comm= | awk '/loginwindow/ {print $1}' | sort -u); do
  launchctl bootout gui/"$uid"/com.palisade.desktop 2>/dev/null || true
done
exit 0
